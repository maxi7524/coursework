configfile: "config/task4.yaml"

YEARS = config["years"]

rule all:
    input:
        "results/report_task4.md"


############################
# PM2.5 — per year
############################

# rule for generating data for every year
rule pm25_year_data:
    input:
        "config/task4.yaml"
    output:
        "results/pm25/{year}/clean_data.csv",
        "results/pm25/{year}/daily_exceedances.csv" # TODO - tutaj trzeba te pliki związne 
    shell:
        """
        python scripts/PM25_year_clean.py \
            --year {wildcards.year} \
            --config config/task4.yaml
        """



