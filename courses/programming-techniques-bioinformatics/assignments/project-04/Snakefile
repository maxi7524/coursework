configfile: "config/task4.yaml"

YEARS = config["years"]

rule all:
    input:
        "results/report_task4.md"


############################
# PM2.5 — per year
############################

# rule for generating data for every year
rule pm25_year_data:
    input:
        "config/task4.yaml"
    output:
        clean="results/pm25/{year}/clean_data.csv",
        exceed="results/pm25/{year}/daily_exceedances.csv" # TODO - tutaj trzeba te pliki związne 
    shell:
        """
        python scripts/PM25_year_clean.py \
            --year {wildcards.year} \
            --config config/task4.yaml
        """
# rule for generating plts
rule pm25_plots:
    input:
        "config/task4.yaml",
        # TODO - tutaj jakoś tego configa i te dane uogólnić na wszystkie roles, bo to bez sensus że wszędzie są pojedyncze zmiany i jedna zmiana i jest rozjazd 
        expand(
            "results/pm25/{year}/clean_data.csv",
            year=YEARS
        ),
        expand(
            "results/pm25/{year}/daily_exceedances.csv",
            year=YEARS
        )
    output:
        plot_years_trend = "results/report_files/plot_years_trend_cities.png"
    shell:
        """
        python scripts/PM25_analysis.py \
            --config config/task4.yaml
        """



